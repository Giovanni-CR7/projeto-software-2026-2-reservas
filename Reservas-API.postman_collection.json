{
  "info": {
    "name": "Reservas API",
    "description": "API de Reserva de Ingressos - Fluxo: Criar Evento → Reservar Ingresso → Confirmar Pagamento → Obter Tickets",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Events",
      "item": [
        {
          "name": "List All Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/events",
              "host": ["{{base_url}}"],
              "path": ["events"]
            },
            "description": "Lista todos os eventos cadastrados"
          },
          "response": []
        },
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Show do Coldplay\",\n  \"eventDate\": \"2026-12-15T20:00:00\",\n  \"totalTickets\": 100,\n  \"price\": 250.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/events",
              "host": ["{{base_url}}"],
              "path": ["events"]
            },
            "description": "Cria um novo evento. Retorna o ID do evento criado."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create Reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"12345678900\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/events/{{event_id}}/reservations",
              "host": ["{{base_url}}"],
              "path": ["events", "{{event_id}}", "reservations"]
            },
            "description": "Cria uma reserva para um evento. Use o event_id retornado ao criar um evento. Retorna o ID da reserva."
          },
          "response": []
        },
        {
          "name": "Confirm Reservation with PIX",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentType\": \"PIX\",\n  \"paymentData\": \"00020126580014br.gov.bcb.pix123456789\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/events/reservations/{{reservation_id}}/confirm",
              "host": ["{{base_url}}"],
              "path": ["events", "reservations", "{{reservation_id}}", "confirm"]
            },
            "description": "Confirma a reserva e processa o pagamento via PIX. Use o reservation_id retornado ao criar uma reserva. O paymentData deve conter a chave PIX de origem."
          },
          "response": []
        },
        {
          "name": "Confirm Reservation with Credit Card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentType\": \"CREDITO\",\n  \"paymentData\": \"4111111111111111\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/events/reservations/{{reservation_id}}/confirm",
              "host": ["{{base_url}}"],
              "path": ["events", "reservations", "{{reservation_id}}", "confirm"]
            },
            "description": "Confirma a reserva e processa o pagamento com Cartão de Crédito. O paymentData deve conter o número do cartão."
          },
          "response": []
        },
        {
          "name": "Confirm Reservation with Boleto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentType\": \"BOLETO\",\n  \"paymentData\": \"12345.67890 12345.678901 12345.678901 1 12345678901234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/events/reservations/{{reservation_id}}/confirm",
              "host": ["{{base_url}}"],
              "path": ["events", "reservations", "{{reservation_id}}", "confirm"]
            },
            "description": "Confirma a reserva e processa o pagamento via Boleto. O paymentData deve conter o número do boleto."
          },
          "response": []
        },
        {
          "name": "List All Reservations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/events/reservations",
              "host": ["{{base_url}}"],
              "path": ["events", "reservations"]
            },
            "description": "Lista todas as reservas com seus detalhes, incluindo status de pagamento"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Get Tickets by CPF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tickets/{{cpf}}",
              "host": ["{{base_url}}"],
              "path": ["tickets", "{{cpf}}"]
            },
            "description": "Lista todos os ingressos confirmados (tickets) para um CPF específico"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "event_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "reservation_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "cpf",
      "value": "12345678900",
      "type": "string"
    }
  ]
}
